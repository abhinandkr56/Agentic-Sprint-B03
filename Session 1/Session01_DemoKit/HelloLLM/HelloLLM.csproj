    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>HelloLLM</RootNamespace>
  </PropertyGroup>

  <!-- No NuGet packages on purpose: Session 1 is "just HttpClient + System.Text.Json". -->

</Project>
